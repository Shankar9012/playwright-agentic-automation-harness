# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# Target application (must be authorized). Change this to point the harness at another site.
BASE_URL=https://qa-demo-website.vercel.app

# Comma-separated hosts the harness may target. Defaults to the BASE_URL host.
# Supports wildcards such as *.vercel.app — keep this as narrow as possible.
ALLOWED_HOSTS=qa-demo-website.vercel.app

# Optional test account for authenticated flows. Leave empty to run only unauthenticated tests.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Execution policy
WORKERS=2
RETRIES=0
TEST_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=5000
ACTION_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000

# Number of run directories kept in artifacts/runs (older ones are pruned)
RUN_RETENTION=20

# Opt-in: allow tests that create a persistent account on the target (TC-AUTH-SIGNUP-003).
# Each run registers a new qa-harness+<stamp>@example.invalid user. Leave false unless agreed.
ALLOW_ACCOUNT_CREATION=false
